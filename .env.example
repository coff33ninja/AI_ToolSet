# Copy this file to .env and fill in the values. .env is git-ignored -
# it holds secrets and must never be committed. `.env.example` is the template.

# Hugging Face token for pyannote speaker diarization (gated model).
# Free account -> Settings > Access Tokens, then accept the license on
# https://huggingface.co/pyannote/speaker-diarization-3.1
# Used by: diarize / get-models --diarize / the streamlit model tab.
HF_TOKEN=hf_...

# Optional: point at an already-populated CUDA/cuDNN bin folder to skip
# scripts/get_cuda_runtime.ps1 (see README "How it works").
# AI_TOOLSET_CUDA_RUNTIME=D:\shared\cuda_runtime\bin

# Optional: directory for pre-downloaded model caches (default ~/.cache).
# AI_TOOLSET_CACHE=D:\AI_ToolSet\model_cache
